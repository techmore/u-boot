stdin=serial,usbkbd,spikbd,mtpkbd
stdout=vidconsole,serial
stderr=vidconsole,serial
boot_targets=nvme usb

# TEST ONLY: persistent breadcrumbs for the J773g from-disk boot path.
crumb_alive_text=M4 U-Boot alive: NVMe scan and ESP FAT write reached
crumb_pre_efi_text=M4 U-Boot pre-EFI: a normal bootflow is about to launch
crumb_returned_text=M4 U-Boot boot returned: all normal bootflows failed or returned
crumb_write_alive=env export -t ${loadaddr} crumb_alive_text; fatwrite nvme 0:4 ${loadaddr} m4-ub-1-alive.txt ${filesize}
crumb_pre_efi=env export -t ${loadaddr} crumb_pre_efi_text; fatwrite nvme 0:4 ${loadaddr} m4-ub-2-pre-efi.txt ${filesize}; consoledump ${loadaddr}; fatwrite nvme 0:4 ${loadaddr} m4-ub-console.txt ${filesize}
crumb_write_returned=env export -t ${loadaddr} crumb_returned_text; fatwrite nvme 0:4 ${loadaddr} m4-ub-3-boot-returned.txt ${filesize}; consoledump ${loadaddr}; fatwrite nvme 0:4 ${loadaddr} m4-ub-console.txt ${filesize}
aurora_efi=if test -n "${fw_dev_part}"; then load nvme ${fw_dev_part} ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI && run crumb_pre_efi && bootefi ${kernel_addr_r} ${fdtcontroladdr}; fi
preboot=nvme scan; run crumb_write_alive
bootcmd=run aurora_boot; run crumb_write_returned; while true; do sleep 60; done
